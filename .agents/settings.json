{
  "mcpServers": {
    "laravel-boost": {
      "command": "php",
      "args": ["artisan", "boost:mcp"]
    },
    "herd": {
      "command": "php",
      "args": [
        "-r",
        "$home=getenv('USERPROFILE')?:getenv('HOME'); if(!$home){fwrite(STDERR,'Unable to resolve USERPROFILE or HOME'.PHP_EOL); exit(1);} require rtrim(str_replace('\\\\','/',$home),'/').'/.config/herd/bin/herd-mcp.phar';"
      ],
      "env": {
        "SITE_PATH": "${workspaceFolder}"
      }
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "postman": {
      "url": "https://mcp.postman.com/minimal",
      "disabled": true
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "autoApprove": ["resolve-library-id", "query-docs"]
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp?client=kiro-power",
      "disabled": true,
      "disabledTools": [],
      "autoApprove": ["web_search_exa", "web_fetch_exa"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    }
  }
}
