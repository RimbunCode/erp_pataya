{
  "php.version": "8.4",
  "php.validate.executablePath": "C:\\Users\\RHD\\.config\\herd\\bin\\php84\\php.exe",
  "Laravel.phpEnvironment": "herd",
  "Laravel.pint.runOnSave": false,
  "[php]": {
    "editor.defaultFormatter": "DEVSENSE.phptools-vscode"
  },
  "php.inlayHints.types.variable": true,
  "php.linkedEditing.variables": false,
  "php.problems.excludeGitIgnore": true,
  "php.problems.exclude": {
    "**/*": ["PHP6615", "PHP0413", "PHP6602", "PHP0416", "PHP0410", "PHP2436"]
  },
  "php.suggest.basic": true,
  "php.validate.enable": true,
  "php.completion.showParameters": true,
  "php.inlayHints.parameters.suppressNameMatchingValue": true,
  "php.format.codeStyle": "Laravel",
  "php.format.rules.indentBraces": false,
  "php.format.rules.finallyOnNewLine": false,
  "php.format.rules.addCommaAfterLastArrayElement": true,
  "php.format.rules.addCommaAfterLastDeclParameter": true,
  "php.format.rules.addCommaAfterLastCallParameter": true,
  "php.format.rules.booleanConstantCasing": "lowercase",
  "php.format.rules.importSorting": "alphabetic",
  "php.format.rules.nullConstantCasing": "lowercase",
  "php.format.rules.openBraceOnNewLineForAnonymousClasses": true,
  "php.format.rules.spaceAroundConcatenation": true,
  "php.format.rules.alignConsecutiveAssignments": true,
  "php.format.rules.alignConstants": true,
  "php.format.rules.alignEnumCases": true,
  "php.format.rules.alignMatchArmBodies": true,
  "php.format.rules.alignProperties": true,
  "php.format.rules.arrayInitializersAlignKeyValuePairs": true,
  "php.format.rules.arrayInitializersNewLineAfterLastElement": true,
  "php.format.rules.arrayInitializersNewLineBeforeFirstElement": true,
  "php.format.rules.callParametersNewLineAfterLeftParen": true,
  "php.format.rules.callParametersNewLineBeforeRightParen": true,
  "php.format.rules.declCompactEmptyBody": true,
  "php.format.rules.declKeepRightParenAndOpenBraceOnOneLine": true,
  "php.format.rules.declParametersNewLineAfterLeftParen": true,
  "php.format.rules.declParametersNewLineBeforeRightParen": true,
  "php.format.rules.forStatementNewLineBeforeRightParen": true,
  "php.format.rules.groupUseNewLineBeforeFirstDeclaration": true,
  "php.format.rules.ifStatementNewLineAfterLeftParen": true,
  "php.format.rules.ifStatementNewLineBeforeRightParen": true,
  "php.format.rules.indentHeredoc": true,
  "php.format.rules.inlineHeredoc": true,
  "php.format.rules.keepClassesOnOneLine": true,
  "php.format.rules.keepControlStatementsOnOneLine": true,
  "php.format.rules.keepFunctionsOnOneLine": true,
  "php.format.rules.newLineAfterImplements": true,
  "php.format.rules.switchStatementNewLineAfterLeftParen": true,
  "php.format.rules.switchStatementNewLineBeforeRightParen": true,
  "php.format.rules.whileStatementNewLineAfterLeftParen": true,
  "php.format.rules.blankLinesAfterClass": 0,
  "php.format.rules.blankLinesAfterClassBody": 0,
  "php.format.rules.blankLinesAfterFunction": 0,
  "php.format.rules.blankLinesAfterMethod": 0,
  "php.format.rules.blankLinesAfterNamespace": 0,
  "php.format.rules.blankLinesAfterOpenTag": 0,
  "php.format.rules.blankLinesAfterUseStatements": 1,
  "php.format.rules.blankLinesAroundClassConstant": 0,
  "php.format.rules.blankLinesAroundEnumCase": 0,
  "php.format.rules.blankLinesAroundProperty": 0,
  "php.format.rules.blankLinesBeforeClass": 1,
  "php.format.rules.blankLinesBeforeClassBody": 0,
  "php.format.rules.blankLinesBeforeFunction": 1,
  "php.format.rules.blankLinesBeforeFunctionBody": 1,
  "php.format.rules.blankLinesBeforeMethod": 1,
  "php.format.rules.blankLinesBeforeMethodBody": 0,
  "php.format.rules.blankLinesBeforeNamespace": 1,
  "php.format.rules.blankLinesBeforeReturnStatement": 1,
  "php.format.rules.blankLinesBeforeUseStatements": 1,
  "php.format.rules.blankLinesBetweenUseTypes": 0,
  "php.format.rules.maxBlankLines": 1,
  "php.format.rules.endWithNewLine": false,
  "php.format.rules.openBraceOnNewLineForBlocks": false,
  "php.format.rules.openBraceOnNewLineForFunctions": false,
  "php.format.rules.openBraceOnNewLineForLambdas": false,
  "php.format.rules.openBraceOnNewLineForNamespaces": false,
  "php.format.rules.openBraceOnNewLineForTypes": false,
  "files.associations": {
    ".env*": "dotenv",
    "*.css": "tailwindcss"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.tabSize": 2,
  "formattingToggle.affects": [
    "editor.formatOnPaste",
    "editor.formatOnSave",
    "editor.formatOnType"
  ],
  "files.eol": "\n",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "prettier.singleQuote": true,
  "eslint.format.enable": true,
  "eslint.run": "onSave",
  "eslint.lintTask.enable": true,
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules/*/**",
    "**/public/vendor/**",
    "**/public/build/**",
    "**/bootstrap/ssr/**"
  ],
  "todo-tree.filtering.ignoreGitSubmodules": true,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "TODO",
    "XXX",
    "[x]",
    "[-]",
    "[~]",
    "[ ]",
    "FIXME",
    "EXAMPLE"
  ],

  "todo-tree.general.tagGroups": {
    "TODO": ["TODO", "todo"],
    "BUG": ["BUG", "bug"],
    "FIX": ["FIX", "FIXME", "fix", "fixme"],
    "HACK": ["HACK", "hack"],
    "XXX": ["XXX", "xxx"],
    "EXAMPLE": ["EXAMPLE"],
    "MARK": ["MARK", "mark"]
  },
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "gutterIcon": true,
      "iconColour": "#00ffff"
    },
    "MARK": {
      "icon": "bookmark"
    },
    "BUG": {
      "icon": "bug",
      "gutterIcon": true,
      "iconColour": "#FFFF00",
      "background": "#FFFF00",
      "foreground": "#000"
    },
    "HACK": {
      "icon": "tools",
      "gutterIcon": true,
      "iconColour": "#ffa600",
      "foreground": "#003a05",
      "background": "#ffa600"
    },
    "XXX": {
      "icon": "x",
      "iconColour": "#FF0000",
      "gutterIcon": true,
      "foreground": "#FFF",
      "background": "#FF0000"
    },
    "EXAMPLE": {
      "gutterIcon": true,
      "icon": "code",
      "hideFromTree": false,
      "foreground": "#c7c7c7",
      "background": "#474747"
    },
    "[x]": {
      "icon": "checklist",
      "iconColour": "#00FF00",
      "foreground": "#000",
      "background": "#00FF00",
      "strikethrough": true,
      "gutterIcon": true
    },
    "[-]": {
      "icon": "$(sparkle-filled)",
      "iconColour": "#004297",
      "foreground": "#ffffff",
      "background": "#002e69"
    },
    "[~]": {
      "icon": "$(session-in-progress)",
      "iconColour": "#470070",
      "foreground": "#ffffff",
      "background": "#470070",
      "gutterIcon": true
    },
    "[ ]": {
      "icon": "$(issues)",
      "foreground": "#c7c7c7",
      "background": "#1f1f1f",
      "gutterIcon": false
    },
    "FIX": {
      "icon": "flame",
      "gutterIcon": true,
      "iconColour": "#ff0000",
      "background": "#ff0000",
      "foreground": "#FFF"
    }
  },
  "todo-tree.highlights.defaultHighlight": {
    "type": "text-and-comment"
  },
  "todo-tree.tree.showBadges": false,
  "todo-tree.tree.scanAtStartup": false,
  "todo-tree.highlights.enabled": true,
  "todo-tree.tree.labelFormat": "${tag:uppercase} ${after} [${filename}]",
  "todo-tree.tree.tooltipFormat": "${filename}:[${line}] in ${filepath}",
  "javascript.autoClosingTags": false
}
