{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶️ Composer Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "composer run dev"
    },
    {
      "name": "▶️ Composer Dev (Simple)",
      "type": "node-terminal",
      "request": "launch",
      "command": "composer run dev:simple"
    },
    {
      "name": "▶️ Composer Dev (Debug)",
      "type": "node-terminal",
      "request": "launch",
      "command": "composer run dev:debug"
    },
    {
      "name": "🐞 Listen Xdebug",
      "type": "php",
      "request": "launch",
      "port": 9005
    },
    {
      "name": "React Vite: Debug Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "https://erp.test:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "React Vite: Debug Edge",
      "type": "msedge",
      "request": "launch",
      "url": "https://erp.test:5173",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Dev Full (Composer + Xdebug)",
      "configurations": ["🐞 Listen Xdebug", "▶️ Composer Dev (Debug)"],
      "stopAll": true
    }
  ]
}
