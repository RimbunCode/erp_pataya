{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "composer",
      "runtimeArgs": [
        "run",
        "dev:simple"
      ],
      "port": 8000
    },
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "serve",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8011",
        "--no-reload"
      ],
      "port": 8011
    },
    {
      "name": "serve-workers",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8013",
        "--no-reload"
      ],
      "env": {
        "PHP_CLI_SERVER_WORKERS": "8"
      },
      "port": 8013
    },
    {
      "name": "ssr",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "inertia:start-ssr"
      ],
      "port": 13714
    },
    {
      "name": "serve-visual",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8012",
        "--no-reload"
      ],
      "port": 8012
    }
  ],
  "autoVerify": true
}
