{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "composer",
      "runtimeArgs": [
        "run",
        "dev:simple"
      ],
      "port": 8000
    },
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "serve",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "artisan",
        "serve",
        "--port=8011"
      ],
      "port": 8011
    }
  ],
  "autoVerify": true
}
